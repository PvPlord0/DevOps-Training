FROM node:24.18.1-alpine3.24
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ENV \
  PORT=8082 \
  PGHOST=eh-pg \
  PGPORT=5432 \
  PGUSER=eventhub \
  PGDATABASE=eventhub_auth \
  JWT_PRIVATE_KEY_PATH=./keys/private.pem

RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

EXPOSE 8082
CMD ["node", "src/index.js"]