FROM node:20-alpine AS installer

WORKDIR /app

COPY package*.json ./

RUN npm ci --omit=dev

FROM node:20-alpine

WORKDIR /app

COPY --from=installer /app/node_modules ./node_modules
COPY --chown=node:node package.json ./
COPY --chown=node:node src ./src

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 CMD wget --quiet --spider http://127.0.0.1:${PORT}/health || exit 1

EXPOSE 8082

USER node

CMD [ "npm", "start" ]

# podman run -d   --name auth-service   -p 8082:8082   --network eventhub-net   --env-file ./.env   -e PGHOST=postgres   -v "$PWD/private.pem:/run/keys/private.pem:ro"   auth-service:optimized