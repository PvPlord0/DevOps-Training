# Stage 1: Dependency builder
FROM docker.io/library/node:24.18.1-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci --only=production || npm install --only=production

# Stage 2: Minimal Runtime
FROM docker.io/library/node:24.18.1-alpine

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY . .

EXPOSE 8080

CMD ["npm", "start"]
