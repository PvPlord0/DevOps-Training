FROM python:3.12.11-slim-trixie AS builder
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
  gcc python3-dev libffi-dev \
  && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

RUN pip install --no-cache-dir --prefix=/install -r requirements.txt



FROM python:3.12.11-slim-trixie

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
  libffi8 \
  && rm -rf /var/lib/apt/lists/*

RUN addgroup --system appgroup && adduser --system --group --home /app appuser

COPY --from=builder --chown=appuser:appgroup /install /usr/local

WORKDIR /app
COPY --chown=appuser:appgroup . .

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PORT=8084

EXPOSE 8084

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import socket; s=socket.socket(); s.connect(('localhost',8084)); s.close()" > /dev/null 2>&1 || exit 1

CMD [ "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8084" ]