FROM maven:3.9.4-eclipse-temurin-17-alpine AS builder

WORKDIR /app

COPY pom.xml ./
RUN mvn -q -DskipTests dependency:go-offline

COPY src ./src

RUN mvn clean package -DskipTests
RUN cp "$(ls target/*.jar | grep -v '\.original$' | head -n 1)" /app/app.jar

FROM eclipse-temurin:17-alpine

WORKDIR /app

COPY --from=builder /app/app.jar ./legacy-catalog-java.jar

ENV SERVER_PORT=8081


EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD wget --quiet --spider http://127.0.0.1:8081/health || exit 1

CMD ["java", "-jar", "legacy-catalog-java.jar"]