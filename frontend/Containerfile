FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./

RUN npm ci

FROM node:20-alpine

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY package.json ./
COPY index.html .
COPY src ./src
COPY vite.config.js .

EXPOSE 3000

ENTRYPOINT [ "npm", "run", "dev", "--", "--host", "0.0.0.0" ]