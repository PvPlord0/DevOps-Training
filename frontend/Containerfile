# Stage 1: Build static React bundle
FROM docker.io/library/node:24.18.1-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci || npm install

COPY . .
RUN npm run build

# Stage 2: Minimal Nginx runtime for SPA serving
FROM docker.io/library/nginx:1.27-alpine

# Copy static assets from build stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Configure Nginx for SPA routing on port 3000
RUN echo 'server { listen 3000; location / { root /usr/share/nginx/html; index index.html; try_files $uri $uri/ /index.html; } }' > /etc/nginx/conf.d/default.conf

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
